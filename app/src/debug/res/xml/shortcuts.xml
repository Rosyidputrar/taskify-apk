<?xml version="1.0" encoding="utf-8"?>
<!-- Salinan shortcuts.xml untuk build debug: targetPackage harus = applicationId (.debug). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="capture"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:shortcutShortLabel="@string/shortcut_capture_short"
        android:shortcutLongLabel="@string/shortcut_capture_long">
        <intent
            android:action="com.rosyidputrar.taskify.action.CAPTURE"
            android:targetPackage="com.rosyidputrar.taskify.debug"
            android:targetClass="com.rosyidputrar.taskify.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:shortcutShortLabel="@string/shortcut_search_short"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent
            android:action="com.rosyidputrar.taskify.action.SEARCH"
            android:targetPackage="com.rosyidputrar.taskify.debug"
            android:targetClass="com.rosyidputrar.taskify.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="calendar"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:shortcutShortLabel="@string/shortcut_calendar_short"
        android:shortcutLongLabel="@string/shortcut_calendar_long">
        <intent
            android:action="com.rosyidputrar.taskify.action.CALENDAR"
            android:targetPackage="com.rosyidputrar.taskify.debug"
            android:targetClass="com.rosyidputrar.taskify.MainActivity" />
    </shortcut>
</shortcuts>
