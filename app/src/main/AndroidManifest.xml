<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Opsional Mode Fokus: menyalakan "Jangan Ganggu" (izin diberikan pengguna di Setelan). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- NetworkMonitor membaca status jaringan (izin normal, diberikan saat instal). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".TaskifyApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Taskify.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Bagikan ke Taskify: teks/tautan dan berkas dari aplikasi lain. -->
            <intent-filter android:label="Taskify">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter android:label="Taskify">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- A5: deep link taskify://task|note|journal → MainActivity (ACTION_VIEW) → AppEvents. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="taskify" android:host="task" />
                <data android:scheme="taskify" android:host="note" />
                <data android:scheme="taskify" android:host="journal" />
            </intent-filter>
        </activity>

        <!-- Widget layar utama "Hari ini". -->
        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_today_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <!--
            Halaman unduh Berkas publik. Host diisi dari PUBLIC_WEB_ORIGIN saat build. Agar tautan
            langsung terbuka di aplikasi (tanpa dialog pilih), web perlu menyajikan
            /.well-known/assetlinks.json dengan sidik jari sertifikat APK; tanpa itu Android tetap
            menawarkan aplikasi ini lewat "Buka dengan" / pengaturan tautan bawaan.
        -->
        <activity
            android:name=".PublicFileActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="Unduh berkas"
            android:theme="@style/Theme.Taskify"
            android:taskAffinity="com.rosyidputrar.taskify.unduh"
            android:excludeFromRecents="false">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="${publicWebHost}" />
                <data android:pathPrefix="/unduh" />
            </intent-filter>
        </activity>
        <!-- Halaman snippet publik Vault (/snippet/<slug>), pola sama dengan halaman unduh. -->
        <activity
            android:name=".PublicSnippetActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="Snippet"
            android:theme="@style/Theme.Taskify"
            android:taskAffinity="com.rosyidputrar.taskify.snippet"
            android:excludeFromRecents="false">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="${publicWebHost}" />
                <data android:pathPrefix="/snippet" />
            </intent-filter>
        </activity>
        <!-- Tile Quick Settings "Tangkap". -->
        <service
            android:name=".widget.CaptureTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_capture"
            android:label="@string/tile_capture_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Mode Fokus: tile Quick Settings + alarm akhir fase & tombol notifikasi. -->
        <service
            android:name=".focus.FocusTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_focus"
            android:label="@string/tile_focus_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
        </service>
        <receiver
            android:name=".focus.FocusReceiver"
            android:exported="true">
            <!-- Alarm hilang setelah kejadian ini → pasang ulang dari sesi tersimpan (lihat FocusReceiver). -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <!--
            Aksi internal Mode Fokus (alarm akhir fase + tombol notifikasi): TIDAK diekspor, tanpa
            intent-filter — hanya PendingIntent milik aplikasi sendiri yang bisa memicunya (D-03).
        -->
        <receiver
            android:name=".focus.FocusActionReceiver"
            android:exported="false" />
        <!-- Sandi sebagai layanan Isi Otomatis Android. -->
        <service
            android:name=".autofill.TaskifyAutofillService"
            android:exported="true"
            android:label="@string/autofill_label"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>
        <activity
            android:name=".autofill.SandiAutofillActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Taskify"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
