<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash Android 12+: kartu muncul membesar dengan pegas, tab merah jatuh ke tempatnya,
  lalu centang tergambar seperti ditulis tangan (±0,8 dtk). Bentuk sama dengan ic_launcher_foreground.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:name="logo"
                android:pivotX="54"
                android:pivotY="57"
                android:scaleX="0.6"
                android:scaleY="0.6">
                <group
                    android:name="tab"
                    android:translateY="-12">
                    <path
                        android:name="tabPath"
                        android:fillAlpha="0"
                        android:fillColor="#A8341A"
                        android:pathData="M60,24h12a4,4 0,0 1,4 4v10h-20v-10a4,4 0,0 1,4 -4z" />
                </group>
                <path
                    android:name="card"
                    android:fillAlpha="0"
                    android:fillColor="#1D5867"
                    android:pathData="M36,32h36a6,6 0,0 1,6 6v38a6,6 0,0 1,-6 6h-36a6,6 0,0 1,-6 -6v-38a6,6 0,0 1,6 -6z" />
                <path
                    android:name="check"
                    android:fillColor="#00000000"
                    android:pathData="M41,58l9,9l17,-19"
                    android:strokeColor="#FAF7F1"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round"
                    android:strokeWidth="6"
                    android:trimPathEnd="0" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="logo">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="420"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="scaleX"
                    android:valueFrom="0.6"
                    android:valueTo="1" />
                <objectAnimator
                    android:duration="420"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="scaleY"
                    android:valueFrom="0.6"
                    android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="card">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="200"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="tab">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="360"
                android:interpolator="@android:anim/overshoot_interpolator"
                android:propertyName="translateY"
                android:startOffset="160"
                android:valueFrom="-12"
                android:valueTo="0" />
        </aapt:attr>
    </target>
    <target android:name="tabPath">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="180"
                android:propertyName="fillAlpha"
                android:startOffset="160"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="check">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="420"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:startOffset="340"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
</animated-vector>
