<?xml version="1.0" encoding="utf-8"?>
<!-- Data lokal (SQLite, kunci perangkat, cache lampiran) tidak boleh ikut backup cloud/transfer:
     sumber kebenaran ada di server, dan kunci perangkat terikat ke perangkat ini. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
