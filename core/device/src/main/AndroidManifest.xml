<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Kesehatan Digital: data pemakaian aplikasi (diberikan pengguna di Setelan → Akses penggunaan). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Nama & ikon aplikasi lain yang muncul di Notifikasi / Kesehatan Digital (tanpa QUERY_ALL_PACKAGES). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application>
        <!-- Modul Notifikasi: pencatat notifikasi (aktif hanya setelah pengguna memberi Akses notifikasi). -->
        <service
            android:name=".TaskifyNotificationListener"
            android:exported="true"
            android:label="Taskify · Notifikasi"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
